# RadioClaw gateway â€?Podman Quadlet (rootless)
# Installed by setup-podman.sh into RadioClaw's ~/.config/containers/systemd/
# {{RadioClaw_HOME}} is replaced at install time.

[Unit]
Description=RadioClaw gateway (rootless Podman)

[Container]
Image=RadioClaw:local
ContainerName=RadioClaw
UserNS=keep-id
# Keep container UID/GID aligned with the invoking user so mounted config is readable.
User=%U:%G
Volume={{RadioClaw_HOME}}/.RadioClaw:/home/node/.RadioClaw
EnvironmentFile={{RadioClaw_HOME}}/.RadioClaw/.env
Environment=HOME=/home/node
Environment=TERM=xterm-256color
PublishPort=18789:18789
PublishPort=18790:18790
Pull=never
Exec=node dist/index.js gateway --bind lan --port 18789

[Service]
TimeoutStartSec=300
Restart=on-failure

[Install]
WantedBy=default.target
