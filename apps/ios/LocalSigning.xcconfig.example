// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

RadioClaw_CODE_SIGN_STYLE = Automatic
RadioClaw_DEVELOPMENT_TEAM = YOUR_TEAM_ID

RadioClaw_APP_BUNDLE_ID = ai.RadioClaw.client
RadioClaw_SHARE_BUNDLE_ID = ai.RadioClaw.client.share
RadioClaw_ACTIVITY_WIDGET_BUNDLE_ID = ai.RadioClaw.client.activitywidget
RadioClaw_WATCH_APP_BUNDLE_ID = ai.RadioClaw.client.watchkitapp
RadioClaw_WATCH_EXTENSION_BUNDLE_ID = ai.RadioClaw.client.watchkitapp.extension

// Leave empty with automatic signing.
RadioClaw_APP_PROFILE =
RadioClaw_SHARE_PROFILE =
